# ===== Máy chủ =====
PORT=4000
NODE_ENV=development
# Địa chỉ Frontend được phép gọi API (CORS). Nhiều địa chỉ cách nhau bằng dấu phẩy.
CLIENT_URL=http://localhost:5173

# ===== Cơ sở dữ liệu MySQL =====
# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://fashionhub:doi_mat_khau_nay@localhost:3306/fashion_hub"

# ===== Xác thực JWT =====
# Tạo chuỗi ngẫu nhiên dài, ví dụ: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=thay_bang_chuoi_ngau_nhien_dai_it_nhat_32_ky_tu
JWT_EXPIRES_IN=7d

# ===== Mật khẩu tài khoản mẫu (chỉ dùng khi chạy seed) =====
SEED_ADMIN_EMAIL=admin@fashionhub.vn
SEED_ADMIN_PASSWORD=Admin@123
SEED_CUSTOMER_PASSWORD=Khach@123

# ===== AI Chatbot (tùy chọn) =====
# AI_PROVIDER: gemini hoặc openai. Để trống API key thì chatbot báo "chưa cấu hình", các chức năng khác vẫn chạy.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
